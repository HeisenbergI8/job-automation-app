# Supabase (Project Settings > API). Locally: `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server/worker only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Claude API (worker + server)
ANTHROPIC_API_KEY=

# Shared secret Vercel Cron sends as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=
