{
  "$schema": "https://raw.githubusercontent.com/HeisenbergI8/provenly/main/harness.schema.json",
  "commands": {
    "verify": "npm run verify",
    "verifyFast": "npm run typecheck"
  },
  "source": {
    "include": [
      "src/**",
      "worker/**",
      "supabase/**",
      "app/**",
      "lib/**",
      "test/**",
      "tests/**"
    ],
    "exclude": [
      "**/*.md",
      "**/__snapshots__/**"
    ]
  },
  "plan": {
    "allowedChecks": [
      "npm run db:test"
    ]
  }
}
